# ---------------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).
# ---------------------------------------------------------------------------

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos ---
# Desarrollo local (PostgreSQL instalado en la computadora):
DATABASE_URL="postgresql://streamtogether:streamtogether@localhost:5432/streamtogether?schema=public"

# En Render o Neon, pega ahi la URL que te den. Ejemplo:
# DATABASE_URL="postgresql://usuario:clave@host:5432/base?sslmode=require"

# --- JWT ---
# Solo identifica la sesion mientras la pestana este abierta.
# Aun asi, en produccion usa un valor aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-de-64-caracteres"
JWT_EXPIRES_IN="30d"

# --- CORS ---
# Origenes permitidos, separados por coma si hay varios.
# En produccion: https://tu-frontend.vercel.app
CLIENT_URL="http://localhost:5173"

# --- Uploads ---
# En el despliegue publico solo se usa YouTube, asi que esto no se llena.
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=524288000