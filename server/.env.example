# ---------------------------------------------------------------------------
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).
# ---------------------------------------------------------------------------

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos ---
# Desarrollo: SQLite local
DATABASE_URL="file:./dev.db"
# Produccion: Postgres (Neon / Supabase). Cambia tambien el provider a
# "postgresql" en prisma/schema.prisma
# DATABASE_URL="postgresql://usuario:password@host/db?sslmode=require"

# --- JWT ---
# IMPORTANTE: genera un secreto fuerte y unico. Si dejas el de ejemplo,
# cualquiera puede firmar tokens falsos.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-de-64-caracteres"
JWT_EXPIRES_IN="7d"

# --- CORS ---
# Origenes permitidos, separados por coma si hay varios.
CLIENT_URL="http://localhost:5173"

# --- Uploads ---
UPLOAD_DIR="./uploads"
# 500 MB
MAX_FILE_SIZE=524288000